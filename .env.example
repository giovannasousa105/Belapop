# =============================================================================
# BelaPop — variáveis de ambiente necessárias
# Copie para .env.local e preencha os valores reais.
# NUNCA commitar .env, .env.local ou .env.production com valores reais.
# =============================================================================

# === SUPABASE ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # NUNCA expor no client

# === STRIPE ==================================================================
STRIPE_SECRET_KEY=sk_live_...           # sk_test_... em desenvolvimento
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...         # webhook da loja (Stripe Dashboard)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_... # webhook do Connect

# === REDIS ===================================================================
REDIS_URL=redis://default:password@...  # Upstash ou Redis próprio

# === CRM / EMAIL =============================================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@belapopoficial.com.br  # remetente padrão para todos os emails
NOTIFICATION_EMAIL_PROVIDER=resend              # provider de email: resend
NOTIFICATION_WHATSAPP_PROVIDER=twilio           # provider de WhatsApp: twilio

# === TWILIO (WhatsApp via Business API) ======================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+14155238886               # número aprovado Twilio (sandbox ou produção)

# === CÍRCULO BELAPOP =========================================================
CIRCULO_JWT_SECRET=                             # gerar: openssl rand -hex 32 — para links de unsubscribe
RESEND_WEBHOOK_SECRET=...
CIRCULO_WHATSAPP_CHANNEL_URL=                   # link do Canal de WhatsApp (drops e conteúdo editorial)
CIRCULO_WHATSAPP_SUBGROUP_ACNE_URL=             # sub-grupo: acne, oleosidade e brilho/poros
CIRCULO_WHATSAPP_SUBGROUP_SPOTS_URL=            # sub-grupo: manchas e tom desigual
CIRCULO_WHATSAPP_SUBGROUP_BARRIER_URL=          # sub-grupo: barreira sensibilizada
CIRCULO_WHATSAPP_SUBGROUP_AGING_URL=            # sub-grupo: firmeza e linhas finas
CIRCULO_WHATSAPP_SUBGROUP_GENERAL_URL=          # sub-grupo: boas-vindas / "ainda não sei"

# === Z-API (WhatsApp alternativo, paralelo ao Twilio) ========================
ZAPI_ENABLED=false                              # true = usa Z-API em vez do NOTIFICATION_WHATSAPP_PROVIDER
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=                              # opcional — Client-Token de segurança da conta Z-API

# === CRONS E JOBS INTERNOS ===================================================
CRON_SECRET=                            # gerar: openssl rand -hex 32
INTERNAL_API_KEY=                       # autenticação entre serviços internos

# === SEGURANÇA ===============================================================
UNSUBSCRIBE_SECRET=                     # HMAC para links de unsubscribe do CRM
CHECKIN_SECRET=                         # HMAC para links de checkin CRM

# === INTEGRAÇÕES =============================================================
CV_SERVICE_URL=http://cv-service:8000   # serviço Python de visão computacional
                                        # vazio em dev = mock local
ANTHROPIC_API_KEY=sk-ant-...            # Claude Vision para Skin Scan — obrigatório
OPENAI_API_KEY=sk-...                   # legado — não usado mais (substituído por Anthropic)
NCBI_API_KEY=                           # PubMed E-utilities (opcional — aumenta rate limit de 3 → 10 req/s)

# === APP =====================================================================
NEXT_PUBLIC_SITE_URL=https://belapopoficial.com.br
NEXT_PUBLIC_BASE_URL=https://belapopoficial.com.br   # alias
NODE_ENV=production

# === SEO =====================================================================
GOOGLE_SITE_VERIFICATION=               # Google Search Console property token

# === ACESSIBILIDADE (opcional) ================================================
NEXT_PUBLIC_ACCESSIBILITY_ACCOUNT_ID=   # accessiBe account ID

# === OBSERVABILIDADE =========================================================
# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=
SENTRY_ORG=belapop
SENTRY_PROJECT=belapop-nextjs

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Logs estruturados
AXIOM_TOKEN=
AXIOM_DATASET=belapop-prod
LOG_LEVEL=info

# Uptime
# Betteruptime/UptimeRobot fica configurado no dashboard externo.
# Monitores sugeridos: /api/health a cada 1min e /api/monitoring a cada 5min
# com Authorization: Bearer {CRON_SECRET}.

# === GO-LIVE COMPLEMENTOS ====================================================
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
SENDGRID_API_KEY=SG...

# Mercado Pago / antifraude (preencher quando o fluxo estiver implementado)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
CLEARSALE_API_KEY=
CLEARSALE_ENTITY_CODE=

# OAuth social
FACEBOOK_OAUTH_ENABLED=false
NEXT_PUBLIC_FACEBOOK_OAUTH_ENABLED=false

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
